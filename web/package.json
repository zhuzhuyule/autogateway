{
  "name": "autogateway-frontend",
  "private": true,
  "version": "2.5.22",
  "description": "AutoGateway frontend — Smart AI API gateway with auto routing, free provider aggregation and unified entry. Built on Vue 3 + Naive UI.",
  "type": "module",
  "keywords": [
    "autogateway",
    "ai-gateway",
    "llm-proxy",
    "auto-routing",
    "vue3",
    "typescript",
    "vite",
    "naive-ui"
  ],
  "author": "AutoGateway contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuzhuyule/autogateway.git",
    "directory": "web"
  },
  "bugs": {
    "url": "https://github.com/zhuzhuyule/autogateway/issues"
  },
  "homepage": "https://github.com/zhuzhuyule/autogateway#readme",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "vue-tsc --build --force",
    "clean": "rm -rf dist node_modules/.vite",
    "test:unit": "echo 'No tests specified' && exit 0",
    "prepare": "echo 'Prepare script for potential Git hooks'",
    "check-all": "npm lint:check && npm format:check && npm type-check"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.88.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^13.6.0",
    "axios": "^1.13.5",
    "dompurify": "^3.4.8",
    "markdown-it": "^14.2.0",
    "naive-ui": "^2.41.0",
    "simple-icons": "^16.18.0",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.24",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.30.1",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vue-tsc": "^2.2.8"
  }
}
